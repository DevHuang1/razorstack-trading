# ─── FastAPI Trading Backend ────────
BACKEND_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_WS_URL=ws://127.0.0.1:8000/events/ws

# ─── Anthropic Claude ───
# Required for the AI Research Desk agents (Sage, Vector, Atlas, Mara, North, Sentinel, Radar, Gauge, Hedge, Apex).
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─── Alpaca Markets ───
# Optional — enables live OHLCV bars and news headlines.
# Without these, the system falls back to synthetic GBM data.
# Get your key at: https://alpaca.markets (free tier works for data)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

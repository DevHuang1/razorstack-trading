# ─── FastAPI Trading Backend ────────
# Vercel: set these to the public Render service URL.
BACKEND_API_URL=http://127.0.0.1:8000
# Server-only API key forwarded as `X-API-Key` to the FastAPI backend. Must
# match the backend's API_KEY setting; leave empty when backend auth is
# disabled (API_KEY="" on the backend). This lets the AI research desk and
# quant desk submit risk-gated proposals when the backend requires auth.
# Do not prefix with NEXT_PUBLIC_.
BACKEND_API_KEY=
NEXT_PUBLIC_BACKEND_WS_URL=ws://127.0.0.1:8000/events/ws

# Optional: file path where the quant paper tracker persists signals/leaderboard.
# Defaults to <repo>/.data/quant-paper.json when not set.
QUANT_PAPER_FILE=

# ─── Groq / xAI ───
# Required for the AI Research Desk agents (Sage, Vector, Atlas, Mara, North, Sentinel, Radar, Gauge, Hedge, Apex)
# and the crisis/structured agents. Key resolution: GROQ_API_KEY -> legacy
# XAI_API_KEY / GROK_API_KEY -> OPENAI_API_KEY. Without a key the desk runs in
# deterministic offline/fallback mode.
# Get your key at: https://console.groq.com
GROQ_API_KEY=
# XAI_API_KEY=                    # legacy alias, same as GROQ_API_KEY
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ─── Alpaca Markets ───
# Optional — enables live OHLCV bars and news headlines.
# Without these, the system falls back to synthetic GBM data.
# Get your key at: https://alpaca.markets (free tier works for data)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=


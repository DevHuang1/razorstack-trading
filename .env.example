# Server-only URL for the FastAPI trading backend. Do not prefix with NEXT_PUBLIC_.
BACKEND_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_WS_URL=ws://127.0.0.1:8000/events/ws

# Server-only API key forwarded as `X-API-Key` to the FastAPI backend.
# Must match the backend's API_KEY setting. Leave empty when backend auth is
# disabled (API_KEY="" on the backend). This lets the AI research desk and quant
# desk submit risk-gated proposals when the backend requires auth.
# Do not prefix with NEXT_PUBLIC_.
BACKEND_API_KEY=

# Optional: file path where the quant paper tracker persists signals/leaderboard.
# Defaults to <repo>/.data/quant-paper.json when not set.
QUANT_PAPER_FILE=

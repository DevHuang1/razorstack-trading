# ─── FastAPI Trading Backend ────────
# In a hosted frontend, set these to the public backend service URL.
BACKEND_API_URL=http://127.0.0.1:8000
BACKEND_API_KEY=
NEXT_PUBLIC_BACKEND_WS_URL=ws://127.0.0.1:8000/events/ws

# ─── Judge Login ──
# Two roles, each with its own passphrase. Choosing an account on the login
# screen signs a 7-day session cookie for that role; the frontend forwards the
# role to the backend (`X-Account-Role`) so devs and judges trade on separate
# paper accounts. AUTH_SESSION_SECRET signs the cookie (generate with:
# openssl rand -hex 32).
PASSPHRASE=JUDGE
DEV_PASSPHRASE=DEV
AUTH_SESSION_SECRET=

# ─── Groq ───
# Required for the AI Research Desk agents (Sage, Vector, Atlas, Mara, North, Sentinel, Radar, Gauge, Hedge, Apex)
# and the crisis/structured agents. Without a key the desk runs in deterministic offline/fallback mode.
# Get your key at: https://console.groq.com
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ─── Alpaca Markets ───
# Optional — enables live OHLCV bars and news headlines.
# Without these, the system falls back to synthetic GBM data.
# Get your key at: https://alpaca.markets (free tier works for data)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# ─── FastAPI Trading Backend ────────
BACKEND_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_WS_URL=ws://127.0.0.1:8000/events/ws

# Server-only API key forwarded as `X-API-Key` to the FastAPI backend.
# Must match the backend's API_KEY setting. Leave empty when backend auth is
# disabled (API_KEY="" on the backend). This lets the AI research desk and quant
# desk submit risk-gated proposals when the backend requires auth.
# Do not prefix with NEXT_PUBLIC_.
BACKEND_API_KEY=

# Optional: file path where the quant paper tracker persists signals/leaderboard.
# Defaults to <repo>/.data/quant-paper.json when not set.
QUANT_PAPER_FILE=

# ─── OpenAI ───
# Required for the AI Research Desk agents (Sage, Vector, Atlas, Mara, North, Sentinel, Radar, Gauge, Hedge, Apex)
# and the crisis/structured agents. Without OPENAI_API_KEY the desk runs in deterministic offline/fallback mode.
# Get your key at: https://platform.openai.com
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Alpaca Markets ───
# Optional — enables live OHLCV bars and news headlines.
# Without these, the system falls back to synthetic GBM data.
# Get your key at: https://alpaca.markets (free tier works for data)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=


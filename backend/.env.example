# --- Application ---
APP_NAME="Alpaca AI Trading Backend"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=*

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./trading_dev.db
AUTO_CREATE_DB=true

# --- Broker (mock requires no credentials) ---
BROKER_MODE=mock
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# OAuth2 client-credentials ("API Keys" 2024) — use INSTEAD of key/secret above.
# Provide client_id + client_secret (+ base_url). A token is fetched at startup.
# ALPACA_CLIENT_ID=
# ALPACA_CLIENT_SECRET=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets
# ALPACA_TOKEN_URL=        # optional; defaults to {base_url}/oauth/token
# ALPACA_OAUTH_TOKEN=      # optional; pre-fetched token (skips exchange)
# ALPACA_OAUTH_SCOPE=trading

# --- Risk limits (fractions of equity) ---
MAX_POSITION_PERCENT=0.15
MAX_SECTOR_EXPOSURE_PERCENT=0.40
MIN_CASH_PERCENT=0.10
MAX_DAILY_LOSS_PERCENT=0.05
MAX_DRAWDOWN_PERCENT=0.10
SECTOR_MAP_JSON=

# --- Mock broker / background tasks ---
MOCK_INITIAL_CASH=100000
MOCK_PRICE_TICK_SECONDS=5
ORDER_POLL_SECONDS=2
